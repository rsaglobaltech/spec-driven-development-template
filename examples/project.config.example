# Required
PROJECT_NAME="Acme Energy Hub"
PROJECT_SLUG="acme-energy-hub"
PROJECT_TYPE="backend"  # backend | frontend
DOMAIN="community energy"
STACK="Quarkus 3.x, Java 21, PostgreSQL, RESTEasy Reactive, SmallRye GraphQL, Maven"
API_STYLE="REST and GraphQL with DTO boundaries"
TESTING="Quarkus Test, Testcontainers, JUnit 5, Cucumber"

# Optional
# How much architectural vocabulary to scaffold (ADR-0022). The gate is the
# same for all three — this decides what `init` writes and what the agent's
# rulebook demands, nothing more.
#   minimal      scripts, landing pages, prototypes — no domain documents
#   layered      most work: CRUD APIs, frontends, services — use-cases.md only
#   tactical-ddd complex domains, several teams — the full domain model
ARCHITECTURE="tactical-ddd"
LANG="en"
MODULES=""  # Optional. Example: "auth,dashboard,billing"
