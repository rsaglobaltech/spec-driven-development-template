{
  "name": "@spec-driven/lsp-server",
  "version": "0.1.0",
  "description": "Language Server (LSP) for create-spec-driven-app projects. Publishes inline traceability.md diagnostics (the same rules as `validate --strict-tdd`) to any LSP-aware editor — VS Code, IntelliJ (LSP4IJ), Neovim.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "spec-driven-lsp": "dist/server.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsaglobaltech/spec-driven-development-template.git",
    "directory": "packages/lsp-spec-driven"
  },
  "keywords": [
    "lsp",
    "language-server",
    "spec-driven",
    "traceability",
    "intellij",
    "vscode"
  ],
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "start": "node src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "main": "dist/server.js"
}
